# Flask Configuration
FLASK_ENV=development
FLASK_SECRET_KEY=your-flask-secret-key-change-in-production

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/data_leak_detection

# Encryption Key (Base64-encoded 32-byte key)
# Generate with: python scripts/generate_encryption_key.py
ENCRYPTION_KEY=your-base64-encoded-encryption-key

# Admin Bootstrap (optional, for first-run admin creation)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-strong-password

# Rate Limiting
RATELIMIT_STORAGE_URI=memory://
